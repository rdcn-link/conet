  "job_yaml": "name: 易发山洪沟道内的淤地坝识别\nsteps:\n- id: terrain_data\n  operator: read_item@1.0\n  inputs: {}\n  params:\n    uri: $TERRAIN_URI\n    view: bytes\n- id: terrain_metrics\n  operator: check_dam_terrain@1.1\n  inputs:\n    source: terrain_data\n  params:\n    operation: terrain\n    region: $REGION\n    region_bbox: $REGION_BBOX\n    entropy_bins: 16\n- id: susceptible_channels\n  operator: check_dam_susceptibility@1.1\n  inputs:\n    source: terrain_metrics\n  params:\n    operation: susceptibility\n    region: $REGION\n    region_bbox: $REGION_BBOX\n    min_slope_ratio: 0.08\n    max_slope_ratio: 0.5\n    max_entropy: 0.2\n    max_downstream_hops: 32\n- id: imagery\n  operator: read_item@1.0\n  inputs: {}\n  params:\n    uri: $IMAGERY_URI\n    view: bytes\n- id: candidate_sites\n  operator: check_dam_detect@1.1\n  inputs:\n    source: imagery\n  params:\n    operation: detect\n    region: $REGION\n    region_bbox: $REGION_BBOX\n    min_confidence: $MIN_CONFIDENCE\n    duplicate_distance_m: 60\n- id: channel_grids\n  operator: read_item@1.0\n  inputs: {}\n  params:\n    uri: $CHANNEL_GRIDS_URI\n    view: bytes\n- id: spatial_overlap\n  operator: check_dam_overlap@1.1\n  inputs:\n    a_hazards: susceptible_channels\n    b_candidates: candidate_sites\n    c_grids: channel_grids\n  params:\n    operation: overlap\n    region: $REGION\n    region_bbox: $REGION_BBOX\n    bias: 3\n- id: distribution_map\n  operator: check_dam_map@1.1\n  inputs:\n    source: spatial_overlap\n  params:\n    operation: map\n    region: $REGION\n    region_bbox: $REGION_BBOX\noutputs:\n  map: distribution_map\n",
